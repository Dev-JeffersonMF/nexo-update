# ── Exemplar de variáveis de ambiente (NÃO commite valores reais) ──
# Copie este arquivo para .env e preencha apenas em desenvolvimento local.
# O .env está no .gitignore e nunca deve ser versionado.
# Chaves EXPO_PUBLIC_* são embutidas no binário do APK — nunca coloque segredos aqui em produção.

# Gemini (usado apenas como banco de pesquisa externa, quando online)
EXPO_PUBLIC_GEMINI_API_KEY=sua_chave_gemini_aqui
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# YouTube (opcional, apenas se houver integração própria)
EXPO_PUBLIC_YOUTUBE_API_KEY=sua_chave_youtube_aqui
